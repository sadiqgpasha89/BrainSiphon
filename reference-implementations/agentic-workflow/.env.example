# Copy to .env (or run `make setup`, which also generates the secrets left blank here). .env is git-ignored.
APP_ENV=local

# Database. Default is a SQLite file under var/. For PostgreSQL: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=
# The operational (source) system's database. Blank = same database as above, which is what the local profile uses.
SOURCE_DATABASE_URL=
# Where model versions are stored. Blank = models/registry
MODEL_REGISTRY_DIR=

# Authentication: local (this service issues HS256 tokens) or oidc (verify RS256 tokens from your identity provider)
AUTH_MODE=local
JWT_SECRET=
TOKEN_TTL_SECONDS=3600
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
JWT_PUBLIC_KEY_FILE=

# Demo users (see configs/users.yaml). Generated by `make setup`.
USER_RESPONDER_PASSWORD=
USER_ANALYST_PASSWORD=
USER_SOC_LEAD_PASSWORD=

# Alerts are always stored in the database; set a webhook (Slack, PagerDuty Events, Alertmanager) to be notified too.
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO
API_PORT=8000
# Only used by the compose profile (infrastructure/docker-compose.yml). Generated by `make setup`.
POSTGRES_PASSWORD=

# Planner. The default is the deterministic policy planner (offline, no key). To let Claude plan the investigation, set
# agent.planner: anthropic in configs/pipeline.yaml and provide a key (or sign in with `ant auth login`).
ANTHROPIC_API_KEY=
