{
  "adapter": "s3",
  "name": "pos-sales-drop",
  "connection": {
    "endpoint": "${S3_ENDPOINT}",
    "bucket": "retail-forecast",
    "region": "us-east-1",
    "path_style": true,
    "access_key_env": "S3_ACCESS_KEY",
    "secret_key_env": "S3_SECRET_KEY"
  },
  "read": {
    "prefix": "inputs/2026-03-01/sales/",
    "format": "jsonl",
    "require_manifest": true,
    "suffix": ".jsonl"
  },
  "write": {
    "prefix": "outputs/2026-03-01/forecast/",
    "format": "jsonl",
    "manifest": true,
    "idempotency_fields": ["sku", "store", "forecast_date"]
  },
  "mapping": {
    "fields": {
      "sku": {
        "from": "sku",
        "required": true
      },
      "store": {
        "from": "store",
        "required": true
      },
      "date": {
        "from": "date",
        "required": true
      },
      "units": {
        "from": "units",
        "transform": ["to_float"],
        "required": true
      }
    }
  },
  "retry": {
    "max_attempts": 4
  }
}
