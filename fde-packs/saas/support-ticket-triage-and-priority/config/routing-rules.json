{
  "_note": "Customer-specific routing rules, ordered. First match wins; no match goes to triage.",
  "rules": [
    {
      "name": "enterprise outage",
      "when": {
        "tier": ["enterprise", "premium"],
        "category": "outage"
      },
      "queue": "critical-incidents",
      "skills": ["sre-liaison"]
    },
    {
      "name": "billing",
      "when": {
        "category": "billing"
      },
      "queue": "billing",
      "skills": ["billing"]
    },
    {
      "name": "spanish support",
      "when": {
        "language": "es"
      },
      "queue": "support-es",
      "skills": ["es"]
    },
    {
      "name": "login and sso",
      "when": {
        "category": "auth"
      },
      "queue": "identity-support",
      "skills": ["sso"]
    },
    {
      "name": "default product",
      "when": {
        "category": ["bug", "how-to", "feature-request"]
      },
      "queue": "product-support",
      "skills": []
    }
  ]
}
