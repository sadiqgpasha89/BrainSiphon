{
  "name": "brainsiphon",
  "version": "1.0.0",
  "private": true,
  "description": "Ultra-high-signal, zero-noise knowledge platform for AI/ML engineers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run content:build && next dev",
    "content:build": "tsx scripts/build-content.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "prebuild": "npm run content:build",
    "build": "next build",
    "build:static": "tsx scripts/build-static.ts",
    "verify:static": "tsx scripts/verify-static.ts",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:sync": "tsx scripts/sync-db.ts",
    "test:playbooks": "tsx scripts/test-playbooks.ts",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@vercel/otel": "^2.3.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  }
}
